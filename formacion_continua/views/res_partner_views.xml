<odoo>
    <record id="view_partner_form_inherit_formacion" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.formacion</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">
                <group string="Formación">
                    <field name="es_formador"/>
                    <field name="especialidad_id"/>
                </group>
            </xpath>

        </field>
    </record>
</odoo>